{
  "manifest_version": 3,
  "name": "Claude Chat Exporter",
  "version": "0.4.2",
  "description": "ProjectD · Auto Memorizer Pipeline — 导出 claude.ai 对话为 Markdown",
  "permissions": ["activeTab", "downloads"],
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["turndown.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
